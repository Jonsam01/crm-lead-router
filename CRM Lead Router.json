      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"hotThreshold\": 80,\n  \"warmThreshold\": 40,\n  \"reviewsTiers\": [[100, 45], [30, 20]],\n  \"ratingTiers\": [[4.5, 45], [3.5, 20]],\n  \"tldWhitelist\": \"com,net,org,co,io,ai,info,biz,au,uk,us,ca,nz\"\n}",
        "includeOtherFields": true,
        "options": {}
      },
      "id": "6475abb5-d027-4922-b025-c6a5db848100",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -528,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cfg = items[0]?.json || {};\n\nconst hot = Number(cfg.hotThreshold);\nconst warm = Number(cfg.warmThreshold);\nconst tlds = String(cfg.tldWhitelist || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nconst reviewsTiers = [...(cfg.reviewsTiers || [])].sort((a, b) => b[0] - a[0]);\nconst ratingTiers = [...(cfg.ratingTiers || [])].sort((a, b) => b[0] - a[0]);\n\nconst prefixes = ['info', 'sales', 'admin', 'contact', 'hello', 'enquiries', 'enquiry', 'reception', 'office', 'mail', 'support', 'bookings', 'accounts'];\nconst emailRe = /^[a-z0-9._%+-]+@[a-z0-9-]+(\\.[a-z0-9-]+)*\\.[a-z]{2,}$/i;\n\n// Normalise header names: \"Email \" -> \"email\", \"Website`\" -> \"website\"\nfunction norm(row) {\n  const o = {};\n  for (const k in row) {\n    o[k.replace(/[^A-Za-z0-9 ]/g, '').trim().toLowerCase()] = row[k];\n  }\n  return o;\n}\n\n// Split multi-email cells, fix \"20info@\" artifacts, validate format and TLD\nfunction cleanEmails(raw) {\n  const list = String(raw || '').split(/[,;\\s]+/).map(e => e.trim().toLowerCase()).filter(Boolean);\n  const out = [];\n  for (let e of list) {\n    e = e.replace(/^mailto:/, '').replace(/^%20/, '');\n    const m = e.match(/^20(.+)@/);\n    if (m && prefixes.some(p => m[1].startsWith(p))) e = e.slice(2);\n    if (!emailRe.test(e)) continue;\n    const tld = e.split('.').pop();\n    if (!tlds.includes(tld)) continue;\n    out.push(e);\n  }\n  return out;\n}\n\nfunction points(value, tiers) {\n  for (const [min, pts] of tiers) {\n    if (value >= min) return pts;\n  }\n  return 0;\n}\n\nconst processedAt = new Date().toISOString();\nconst executionId = String($execution.id);\nconst seen = new Set();\nconst results = [];\n\nfor (const item of items) {\n  const r = norm(item.json);\n  const mapsLink = String(r['maps link'] || '').trim();\n\n  // Skip blank rows, already-processed rows, and duplicates in this batch\n  if (!mapsLink) continue;\n  const prior = String(r['status'] || '').trim().toLowerCase();\n  if (prior === 'scored' || prior === 'pushed') continue;\n  if (seen.has(mapsLink)) continue;\n  seen.add(mapsLink);\n\n  const reviews = Number(String(r['reviews']).replace(/,/g, ''));\n  const rating = Number(String(r['rating']).replace(/,/g, ''));\n  const emails = cleanEmails(r['email']);\n  const email = emails[0] || '';\n\n  const base = {\n    name: String(r['name'] || '').trim(),\n    email,\n    phone: String(r['phone'] || '').trim(),\n    website: String(r['website'] || '').trim(),\n    reviews,\n    rating,\n    mapsLink,\n    processedAt,\n    executionId\n  };\n\n  // Validation gate: numeric reviews and rating are required\n  if (r['reviews'] === '' || r['rating'] === '' || Number.isNaN(reviews) || Number.isNaN(rating)) {\n    results.push({ json: { ...base, score: '', tier: '', status: 'Failed', error: 'Invalid or missing Reviews/Rating' } });\n    continue;\n  }\n\n  const score = points(reviews, reviewsTiers) + points(rating, ratingTiers);\n\n  // Email gate: no valid email means the lead can never rise above Cold\n  let tier = 'Cold';\n  if (email && score >= hot) tier = 'Hot';\n  else if (email && score >= warm) tier = 'Warm';\n\n  results.push({ json: { ...base, score, tier, status: 'Scored', error: '' } });\n}\n\nreturn results;"
      },

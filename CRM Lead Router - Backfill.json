    {
      "parameters": {
        "jsCode": "const BATCH_SIZE = 25;\n\nconst rows = $input.all();\nconst seen = new Set();\nconst batch = [];\n\nfor (const item of rows) {\n  const r = item.json;\n  const mapsLink = String(r['Maps Link'] || '').trim();\n  if (!mapsLink) continue;\n\n  // A link seen higher in the sheet means this row is a duplicate lead\n  if (seen.has(mapsLink)) continue;\n  seen.add(mapsLink);\n\n  const status = String(r['Status'] || '').trim();\n  if (status) continue;\n\n  if (batch.length < BATCH_SIZE) batch.push({ json: r });\n}\n\nreturn batch;"
      },

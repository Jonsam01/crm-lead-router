    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cutoff = Date.now() - 24 * 60 * 60 * 1000;\n\nconst stats = { processed: 0, hotPushed: 0, hotPending: 0, warm: 0, cold: 0, failed: 0 };\nconst hotNames = [];\n\nfor (const r of rows) {\n  if (!r['Maps Link']) continue;\n\n  const status = String(r['Status'] || '').trim().toLowerCase();\n  if (!['scored', 'pushed', 'failed'].includes(status)) continue;\n\n  const ts = Date.parse(r['Processed_At']);\n  if (Number.isNaN(ts) || ts < cutoff) continue;\n\n  stats.processed++;\n\n  if (status === 'failed') {\n    stats.failed++;\n    continue;\n  }\n\n  const tier = String(r['Tier'] || '').trim();\n  if (tier === 'Hot' && status === 'pushed') {\n    stats.hotPushed++;\n    hotNames.push(r['Name']);\n  } else if (tier === 'Hot') {\n    stats.hotPending++;\n  } else if (tier === 'Warm') {\n    stats.warm++;\n  } else if (tier === 'Cold') {\n    stats.cold++;\n  }\n}\n\nconst date = new Date().toISOString().slice(0, 10);\nconst lines = [\n  `📊 CRM Lead Router digest (${date}, last 24h)`,\n  `Processed: ${stats.processed}`,\n  `🔥 Hot pushed to HubSpot: ${stats.hotPushed}`,\n  `Warm: ${stats.warm}`,\n  `Cold: ${stats.cold}`,\n  `⚠️ Hot waiting to push: ${stats.hotPending}`,\n  `❌ Failed validation: ${stats.failed}`\n];\nif (hotNames.length) lines.push('', 'Hot leads:', ...hotNames.map(n => `- ${n}`));\nif (!stats.processed) lines.push('', 'No leads were processed in the last 24 hours.');\n\nreturn [{ json: { ...stats, message: lines.join('\\n') } }];"
      },
